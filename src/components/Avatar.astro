---
// Yagmur's own illustration in the site's colours, in three layers so the brows and the smile can move.
// In the contact panel: on open she raises her brows, smiles wider and tilts her head hello.
---
<div class="avatar" role="img" aria-label="Illustration of Yagmur smiling">
  <div class="av-head">
    <img class="av-base" src="/images/avatar-base.webp" alt="" width="1105" height="1105" />
    <img class="av-brows" src="/images/avatar-brows.webp" alt="" width="380" height="73" />
    <img class="av-mouth" src="/images/avatar-mouth.webp" alt="" width="160" height="74" />
  </div>
</div>

<style>
  .avatar { position: relative; width: 100%; height: 100%; border-radius: 50%; overflow: hidden; background: #d6d6d6; }
  .av-head { position: absolute; inset: 0; transform-origin: 50% 90%; }
  .av-head img { position: absolute; display: block; height: auto; }
  .av-base { inset: 0; width: 100%; }
  .av-brows { left: 32.85%; top: 28.69%; width: 34.39%; }
  .av-mouth { left: 46.15%; top: 48.14%; width: 14.48%; transform-origin: 50% 40%; }

  :global(.contact.is-open) .av-brows { animation: av-brows 1.8s cubic-bezier(.25,.46,.45,.94) 300ms both; }
  :global(.contact.is-open) .av-mouth { animation: av-smile 1.8s cubic-bezier(.25,.46,.45,.94) 300ms both; }
  :global(.contact.is-open) .av-head { animation: av-hello 1.6s ease-in-out 300ms both; }
  @keyframes av-brows { 0% { transform: none; } 22%, 65% { transform: translateY(-22%); } 100% { transform: translateY(-6%); } }
  @keyframes av-smile { 0% { transform: none; } 25%, 100% { transform: scale(1.14, 1.2); } }
  @keyframes av-hello {
    0%, 100% { transform: none; }
    20% { transform: rotate(-5deg); } 40% { transform: rotate(4deg); } 60% { transform: rotate(-3deg); } 80% { transform: rotate(1deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.contact.is-open) .av-brows, :global(.contact.is-open) .av-mouth, :global(.contact.is-open) .av-head { animation: none; }
  }
</style>
