---
interface Props {
  current?: 'work' | 'about';
}
const { current } = Astro.props;
---
<header class="wrap topbar">
  <a href="/">Yagmur Şimşek Sönmez</a>
  <span class="topbar__muted topbar__role">Product Designer</span>
  <span class="topbar__muted topbar__clock">Berlin <time data-clock>--:--</time></span>
  <nav class="topbar__nav" aria-label="Main">
    <a href="/#work" aria-current={current === 'work' ? 'page' : undefined}>Work</a>
    <a href="/#about" aria-current={current === 'about' ? 'page' : undefined}>About</a>
    <a class="btn btn--sm" href="mailto:n.yagmur.simsek@gmail.com">Contact +</a>
  </nav>
</header>
