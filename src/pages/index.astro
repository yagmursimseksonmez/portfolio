---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import site from '../data/site.json';
import { person } from '../data/person';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const count = projects.length;
const frameHtml = import.meta.glob('../content/playmate-frames/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const rendered = await Promise.all(projects.map(async (p) => (await render(p)).Content));
const isWide = (img: { width?: number; height?: number }) => !!img.width && !!img.height && img.width > img.height;

// Newest first; `years` is how many year rows each role spans on the timeline.
const jobs = [
  { company: 'Konkret', title: 'Product Designer · freelance', years: 2, when: 'Feb 2025 – now' },
  { company: 'Hergele Mobility', title: 'Product Designer', years: 1, when: 'Feb 2024 – Feb 2025' },
  { company: 'Kitbox', title: 'Product Designer', years: 1, when: 'Sep 2023 – Jan 2024' },
  { company: 'Bahçeşehir & Beykent', title: 'Design Lecturer', years: 2, when: 'Aug 2021 – Aug 2025' },
  { company: 'Beykent University', title: 'Lead Visual Designer', years: 2, when: 'May 2019 – Jun 2021' },
  { company: 'Valencia Tech · Beykent', title: 'UX Researcher', years: 3, when: 'Apr 2016 – May 2019' },
];
const years = Array.from({ length: jobs.reduce((n, j) => n + j.years, 0) }, (_, i) => 2026 - i);

const arrow = '<svg class="arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10h13m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Base
  title={site.home.title}
  description={site.home.description}
  image={site.home.image}
  intro
  jsonLd={[
    { '@context': 'https://schema.org', ...person },
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Yagmur Şimşek Sönmez — Product Designer',
      url: 'https://yagmursimseksonmez.com/',
      inLanguage: 'en',
      author: { '@id': person['@id'] },
    },
  ]}
>
  <div id="root">
    <div class="contact" data-contact>
      <div class="contact-panel">
        <button class="contact-toggle" type="button" aria-expanded="false" aria-controls="contact-menu" data-contact-toggle>
          <h3>Contact</h3>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9 3h2v6h6v2h-6v6H9v-6H3V9h6z" /></svg>
        </button>
        <div class="contact-menu" id="contact-menu" aria-hidden="true">
          <div class="contact-card" data-hours>
            <div class="contact-status"><h3 data-open-label>Open</h3><h3 data-reopens hidden></h3></div>
            <div class="contact-time">
              <div class="clock avatar-wrap"><Avatar /></div>
            </div>
            <div class="contact-foot">
              <h3>Open to product design roles and selected freelance projects</h3>
              <h4>Based in Berlin · working in English, Turkish and German</h4>
            </div>
          </div>
          <a class="link primary" href="mailto:n.yagmur.simsek@gmail.com"><h3>Get in touch</h3><Fragment set:html={arrow} /></a>
          <div class="email">
            <a href="mailto:n.yagmur.simsek@gmail.com"><h3>n.yagmur.simsek@gmail.com</h3></a>
            <button type="button" data-copy="n.yagmur.simsek@gmail.com">Copy</button>
          </div>
          <a class="link" href="https://www.linkedin.com/in/yagmursimseks" target="_blank" rel="noopener noreferrer"><h3>LinkedIn</h3><Fragment set:html={arrow} /></a>
        </div>
      </div>
    </div>

    <header>
      <nav class="grid">
        <h3>Yagmur Şimşek Sönmez</h3>
        <h3>Product Designer</h3>
        <h3>“Portfolio”</h3>
        <h3><span data-clock>--:--</span> Berlin</h3>
      </nav>
      <div class="hero">
        <h1 class="sr-only">Yagmur Şimşek Sönmez — I design things</h1>
        <div class="build" data-hero aria-hidden="true"><canvas></canvas></div>
      </div>
      <div class="subheader grid">
        <h3>Selected work ↓</h3>
        <p>
          Designer. Researcher. Crafter. PhD in architectural history, Master’s in visual communication design. Strong interest in visual identity.{' '}
          <a class="inline" href="#about" data-open-book>Wanna know me better?</a>
        </p>
      </div>
    </header>

    <main class="gallery" id="gallery" style={`--count:${count}`} data-gallery>
      <button class="gallery-dismiss" type="button" aria-label="Close" data-dismiss>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9 3h2v6h6v2h-6v6H9v-6H3V9h6z" /></svg>
      </button>
      <div class="gallery-keys" aria-hidden="true"><span>↑</span><span>←</span><span>↓</span><span>→</span></div>

      <div class="gallery-stage">
        <section class="book" id="about" tabindex="0" aria-label="About Yagmur" data-book>
          <div class="book-stage">
            <div class="book-leaf">
              <div class="book-face book-cover"><h2>Hi</h2></div>
              <div class="book-face book-left"><img src="/images/IMG_5630.webp" alt="Yagmur in a courtyard in Istanbul" width="1824" height="1273" decoding="async" /></div>
            </div>
            <div class="book-right">
              <div class="book-scroll" data-book-scroll>
                <div class="about">
                  <div class="about-head">
                    <h2>Hi, I’m Yagmur.</h2>
                    <p class="about-lede">I’m a product designer in Berlin. I design apps from the first user interview to the App Store.</p>
                  </div>
                  <ul class="about-facts" aria-label="In short">
                    <li><span>Based in</span>Berlin</li>
                    <li><span>Speaks</span>English, German, Turkish</li>
                    <li><span>PhD</span>History and theory of architecture</li>
                    <li><span>Master’s</span>Visual communication design</li>
                    <li><span>Shipped</span>4 apps on the App Store</li>
                    <li><span>Outside work</span>I dance Lindy Hop</li>
                  </ul>
                  <section class="about-story">
                    <h3>How I got here</h3>
                    <p>I didn’t start in tech. I spent years with buildings: a PhD in architectural history, a master’s in visual communication, and four years teaching design students.</p>
                    <p>What stayed with me is how people find their way through a place, and what makes them get lost. Apps are places too. So now I design those.</p>
                  </section>
                  <figure class="about-photo">
                    <img src="/images/conference-dare.webp" alt="Yagmur presenting at the Digital Architecture Research conference" width="1920" height="1207" loading="lazy" decoding="async" />
                    <figcaption>Presenting at the Digital Architecture Research conference · Bialystok, Poland, 2025</figcaption>
                  </figure>
                  <figure class="about-photo">
                    <img src="/images/conference-ecgbl.webp" alt="Yagmur presenting her gamification research at the ECGBL conference" width="1500" height="2000" loading="lazy" decoding="async" />
                    <figcaption>Presenting at the ECGBL Conference · Levanger, Norway, 2025</figcaption>
                  </figure>
                  <section class="about-how">
                    <h3>How I work</h3>
                    <ul>
                      <li><strong>People first.</strong> I talk to users and test with them before and after I draw.</li>
                      <li><strong>I explain my choices.</strong> Teaching made that a habit. Every screen has a reason I can say out loud.</li>
                      <li><strong>Close to the team.</strong> I like working next to founders and developers, not handing files over a wall.</li>
                    </ul>
                  </section>
                  <section class="about-work">
                    <h3>Where I’ve worked</h3>
                    <ol>
                      {jobs.map((j) => <li><div><strong>{j.company}</strong><span>{j.title}</span></div><time>{j.when}</time></li>)}
                    </ol>
                  </section>
                  <section class="about-hello">
                    <h3>Say hello</h3>
                    <p>If you’re building something people should find easy to use, I’d like to hear about it.</p>
                    <div class="bio-links">
                      <a class="link primary" href="mailto:n.yagmur.simsek@gmail.com"><h3>Email me</h3><Fragment set:html={arrow} /></a>
                      <a class="link" href="https://www.linkedin.com/in/yagmursimseks" target="_blank" rel="noopener noreferrer"><h3>LinkedIn</h3><Fragment set:html={arrow} /></a>
                      <a class="link" href="https://yildiz.academia.edu/NagehanYagmurSimsekSonmez" target="_blank" rel="noopener noreferrer"><h3>Academia</h3><Fragment set:html={arrow} /></a>
                      <a class="link" href="https://www.flickr.com/people/126174140@N08/" target="_blank" rel="noopener noreferrer"><h3>My photos</h3><Fragment set:html={arrow} /></a>
                    </div>
                  </section>
                </div>
              </div>
            </div>
          </div>
        </section>

        {projects.map((p, k) => {
          const d = p.data;
          const Content = rendered[k];
          const role = d.facts.find((f) => f.label === 'Role')?.value;
          const platform = d.facts.find((f) => f.label === 'Platform')?.value;
          const tools = d.facts.find((f) => f.label === 'Tools')?.value;
          return (
            <section class="card" id={p.id} style={`--i:${count - 1 - k};--slot:${k}`} aria-label={d.title} tabindex="0" data-card>
              <div class="card-tab"><h2 class:list={{ "has-note": !!d.tabNote }}><span>{d.title}</span>{d.tabNote && <small class="tab-note">{d.tabNote}</small>}</h2></div>
              <div class="card-sheet">
                <article class="card-content">
                  <div class="work">
                    {d.hero?.frame && (
                      <figure class="pmx" aria-label="Overview" set:html={frameHtml[`../content/playmate-frames/${d.hero.frame}.html`]}></figure>
                    )}
                    {d.hero && !d.hero.frame && (
                      <figure class:list={['hero', { compact: d.hero.compact }]}>
                        {d.hero.concept ? (
                          <div class:list={['concept-stage', { flat: d.hero.concept.flat }]} role="img" aria-label={d.hero.concept.video.label}>
                            {d.hero.concept.flat ? (
                              <video src={d.hero.concept.video.src} width={d.hero.concept.video.width} height={d.hero.concept.video.height} autoplay muted loop playsinline preload="metadata"></video>
                            ) : (<>
                            <div class="concept-back" aria-hidden="true"></div>
                            <div class="concept-phone">
                              <div class="device"><video src={d.hero.concept.video.src} width={d.hero.concept.video.width} height={d.hero.concept.video.height} autoplay muted loop playsinline preload="metadata"></video></div>
                            </div>
                            {d.hero.concept.words.map((w) => (
                              <span class={`concept-word tone-${w.tone}`} style={`left:${w.x}%;top:${w.y}%;--rot:${w.rotate}deg`}>{w.text}</span>
                            ))}
                            </>)}
                          </div>
                        ) : d.showcase ? (
                          <div class="showcase-stage hero-stage">
                            <img src={d.showcase.image.src} alt={d.showcase.image.alt} width={d.showcase.image.width} height={d.showcase.image.height} decoding="async" loading={k < 2 ? 'eager' : 'lazy'} />
                            <video src={d.showcase.video.src} width={d.showcase.video.width} height={d.showcase.video.height} aria-label={d.showcase.video.label} autoplay muted loop playsinline preload="metadata"></video>
                          </div>
                        ) : d.hero.video && (
                          <div class="device">
                            <video src={d.hero.video.src} width={d.hero.video.width} height={d.hero.video.height} aria-label={d.hero.video.label} autoplay muted loop playsinline preload="metadata"></video>
                          </div>
                        )}
                        <div class="hero-copy">
                          <div class="hero-top">
                            <h4>{d.hero.kicker}</h4>
                            <h2>{d.hero.title}</h2>
                            <p class="hero-lede">{d.hero.lede}</p>
                            {d.hero.hp && (
                              <div class="hp" role="img" aria-label={`${d.hero.hp.label}: ${d.hero.hp.value} of 10`}>
                                <svg class="hp-heart" viewBox="0 0 9 8" aria-hidden="true" shape-rendering="crispEdges"><path d="M1 0h2v1h1v1h1V1h1V0h2v1h1v3H8v1H7v1H6v1H5v1H4V7H3V6H2V5H1V4H0V1h1z" /></svg>
                                <div class="hp-bar" aria-hidden="true">{Array.from({ length: 10 }, (_, n) => <i class:list={{ on: n < d.hero!.hp!.value }} style={`--n:${n}`}></i>)}</div>
                                <span class="hp-label">{d.hero.hp.label}</span>
                              </div>
                            )}
                          </div>
                          {d.hero.points.length > 0 && (
                            <ul class="hero-points">
                              {d.hero.points.map((pt, n) => (
                                <li><span>{pt.label ?? String(n + 1).padStart(2, '0')}</span><h3>{pt.title}</h3><p>{pt.text}</p></li>
                              ))}
                            </ul>
                          )}
                          <div class="hero-foot">
                            {d.hero.chips.length > 0 && <ul class="chips">{d.hero.chips.map((c) => <li>{c}</li>)}</ul>}
                            {d.link && <a class="link primary" href={d.link.href} target="_blank" rel="noopener noreferrer"><h3>App Store</h3><Fragment set:html={arrow} /></a>}
                          </div>
                        </div>
                      </figure>
                    )}
                    {d.showcase && !d.hero && (
                      <figure class="showcase">
                        <div class="showcase-stage">
                          <img src={d.showcase.image.src} alt={d.showcase.image.alt} width={d.showcase.image.width} height={d.showcase.image.height} decoding="async" loading={k < 2 ? 'eager' : 'lazy'} />
                          <video src={d.showcase.video.src} width={d.showcase.video.width} height={d.showcase.video.height} aria-label={d.showcase.video.label} autoplay muted loop playsinline preload="metadata"></video>
                        </div>
                      </figure>
                    )}
                    {d.video && (
                      <figure>
                        <video class="clip" src={d.video.src} width={d.video.width} height={d.video.height} aria-label={d.video.label} autoplay muted loop playsinline preload="metadata"></video>
                      </figure>
                    )}
                    {d.cover && !d.hero && (
                      <figure class="cover"><img src={d.cover.src} alt={d.cover.alt} width={d.cover.width} height={d.cover.height} decoding="async" loading={k < 2 ? 'eager' : 'lazy'} /></figure>
                    )}
                    {!d.cover && !d.showcase && !d.hero && <figure class="placeholder">Case study in progress</figure>}
                    {d.gallery.filter((g) => !g.info && !g.frame?.endsWith('summary')).map((g) => g.frame ? (
                      <figure class="pmx" aria-label={g.label} set:html={frameHtml[`../content/playmate-frames/${g.frame}.html`]}></figure>
                    ) : g.panels ? (
                      <figure class="panels" aria-label={g.label}>
                        {g.step ? (
                          <div class="step-head"><span class="step-n">{g.step.n}</span>{g.step.name && <h4>{g.step.name}</h4>}{g.step.text && <p>{g.step.text}</p>}</div>
                        ) : (
                          <div class="story-head"><h4>{g.label}</h4>{g.title && <h3>{g.title}</h3>}</div>
                        )}
                        <div class="panel-row">
                          {g.panels.map((col) => (
                            <div class:list={['panel-col', { 'has-pic': !!col.image }]} style={col.width ? `width:${col.width}px` : undefined}>
                              {col.title && <h4 class="panel-title">{col.title}</h4>}
                              {col.image && (
                                <div class="panel-pic" style={col.image.width && col.image.height ? `--ar:${col.image.width} / ${col.image.height}` : undefined}>
                                  <img src={col.image.src} alt={col.image.alt} width={col.image.width} height={col.image.height} loading="lazy" decoding="async" />
                                  {col.image.label && <span class="panel-pic-label">{col.image.label}</span>}
                                </div>
                              )}
                              {col.cards.map((c) => <section class="panel-card" style={c.grow !== 1 ? `flex-grow:${c.grow}` : undefined}><h5>{c.title}</h5>{c.text && <p>{c.text}</p>}{c.items.length > 0 && <ol>{c.items.map((it) => <li>{it}</li>)}</ol>}</section>)}
                              {col.rows.map((r) => <div class="panel-cards-row">{r.map((c) => <section class="panel-card" style={c.grow !== 1 ? `flex-grow:${c.grow}` : undefined}><h5>{c.title}</h5>{c.text && <p>{c.text}</p>}{c.items.length > 0 && <ol>{c.items.map((it) => <li>{it}</li>)}</ol>}</section>)}</div>)}
                            </div>
                          ))}
                        </div>
                      </figure>
                    ) : g.notes && g.src ? (
                      <figure class="annotated" aria-label={g.label}>
                        {g.step ? (
                          <div class="step-head"><span class="step-n">{g.step.n}</span>{g.step.name && <h4>{g.step.name}</h4>}{g.step.text && <p>{g.step.text}</p>}</div>
                        ) : (
                          <div class="story-head"><h4>{g.label}</h4>{g.title && <h3>{g.title}</h3>}</div>
                        )}
                        <div class="annot">
                          {[g.notes.slice(0, Math.ceil(g.notes.length / 2)), g.notes.slice(Math.ceil(g.notes.length / 2))].map((side, i) => (<>
                            {i === 1 && (
                              <div class="annot-pic" style={g.width && g.height ? `--ar:${g.width} / ${g.height}` : undefined}>
                                <img src={g.src} alt={g.alt ?? ''} width={g.width} height={g.height} loading="lazy" decoding="async" />
                                {g.notes!.map((nt) => <span class="annot-box" style={`left:${nt.x}%;top:${nt.y}%;width:${nt.w}%;height:${nt.h}%`} aria-hidden="true"><b>{nt.n}</b></span>)}
                              </div>
                            )}
                            <ol class="annot-notes">{side.map((nt) => <li><span class="annot-n" aria-hidden="true">{nt.n}</span><div><strong>{nt.title}</strong><span>{nt.text}</span></div></li>)}</ol>
                          </>))}
                        </div>
                      </figure>
                    ) : g.beats ? (
                      <figure class:list={['story', { rows: g.rows, grid: g.grid, stack: g.stack }]} aria-label={g.label}>
                        {g.step ? (
                          <div class="step-head"><span class="step-n">{g.step.n}</span>{g.step.name && <h4>{g.step.name}</h4>}{g.step.text && <p>{g.step.text}</p>}</div>
                        ) : (
                          <div class="story-head"><h4>{g.label}</h4>{g.title && <h3>{g.title}</h3>}</div>
                        )}
                        <div class="beats">
                          {g.beats.map((b) => (
                            <section class:list={['beat', { wide: b.wide, 'has-shot': !!b.image || b.images.length > 0, 'has-cols': b.columns > 1 }]} style={b.columns > 1 ? `--cols:${b.columns}` : undefined}>
                              <div class="beat-name">{b.letter && <span class="beat-letter" aria-hidden="true">{b.letter}</span>}<h4>{b.name}</h4></div>
                              {b.text && <p>{b.text}</p>}
                              {b.points.length > 0 && (
                                <ul class="beat-points">{b.points.map((pt) => <li><strong>{pt.title}</strong><span>{pt.text}</span></li>)}</ul>
                              )}
                              {b.stats.length > 0 && (
                                <ul class="beat-stats">{b.stats.map((st) => <li><strong>{st.value}</strong><span>{st.label}</span></li>)}</ul>
                              )}
                              {b.quote && <blockquote>{b.quote}</blockquote>}
                              {b.image && (
                                <div class="beat-shot" tabindex="0" role="group" aria-label={b.image.alt}>
                                  <img src={b.image.src} alt={b.image.alt} width={b.image.width} height={b.image.height} loading="lazy" decoding="async" />
                                </div>
                              )}
                              {b.images.length > 0 && (
                                <div class="beat-shot stack" tabindex="0" role="group" aria-label={`${b.name}: ${b.images.map((m) => m.label ?? m.alt).join('; ')}`}>
                                  {b.images.map((m) => (<>
                                    {m.label && <p class="beat-shot-label">{m.label}</p>}
                                    <img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" />
                                  </>))}
                                </div>
                              )}
                            </section>
                          ))}
                        </div>
                      </figure>
                    ) : (
                      <figure class:list={{ tall: g.tall, screens: g.screens, devices: g.device, scrolls: g.scroll, captioned: g.items?.some((m) => m.caption) }} style={g.tall && g.width && g.height ? `--r:${(g.width / g.height).toFixed(4)}` : undefined} tabindex={g.tall ? 0 : undefined} data-tall={g.tall ? '' : undefined}>
                        <div class="board">
                          <div><h4>{g.label}</h4><h3>{g.title}</h3></div>
                          <div class="board-shots">
                            {(g.items ?? [{ src: g.src!, alt: g.alt ?? '', width: g.width, height: g.height }]).map((m) =>
                              m.src.endsWith('.mp4') && g.device ? (
                                <div class="device"><video src={m.src} width={m.width} height={m.height} aria-label={m.alt} autoplay muted loop playsinline preload="metadata"></video></div>
                              ) : m.src.endsWith('.mp4') ? (
                                <video class="shot-video" src={m.src} width={m.width} height={m.height} aria-label={m.alt} autoplay muted loop playsinline preload="metadata"></video>
                              ) : g.device && g.items ? (
                                <div class="shot">
                                  {m.caption && <p class="shot-cap"><strong>{m.caption.title}</strong>{m.caption.text}</p>}
                                  {g.scroll ? (
                                    <div class="device"><div class="device-clip">
                                      {m.head && <img class="pin" src={m.head.src} alt="" width={m.head.width} height={m.head.height} loading="lazy" decoding="async" />}
                                      <div class="device-scroll" tabindex="0" role="group" aria-label={m.alt}>
                                        <div class="scroll-body" style={m.foot ? `padding-bottom:${((m.foot.nav / m.foot.width!) * 100).toFixed(3)}%` : undefined}><img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" /></div>
                                      </div>
                                      {m.foot && <img class="pin pin-foot" src={m.foot.src} alt="" width={m.foot.width} height={m.foot.height} loading="lazy" decoding="async" />}
                                    </div></div>
                                  ) : (
                                    <div class="device"><img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" /></div>
                                  )}
                                </div>
                              ) : g.tall && g.items ? (
                                <div class="screen-window"><img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" /></div>
                              ) : m.open ? (
                                <a href={m.src} target="_blank" rel="noopener noreferrer" aria-label={`${m.alt} (opens full size)`}><img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" /></a>
                              ) : (
                                <img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" />
                              ),
                            )}
                          </div>
                        </div>
                      </figure>
                    ))}
                    {d.compare && (
                      <figure>
                        <div class="compare" data-compare>
                          <img src={d.compare.before.src} alt={d.compare.before.alt} draggable="false" loading="lazy" decoding="async" />
                          <img class="after" src={d.compare.after.src} alt={d.compare.after.alt} draggable="false" loading="lazy" decoding="async" />
                          <div class="compare-handle">
                            <button class="compare-knob" type="button" role="slider" aria-label="Compare before and after" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
                              <svg width="8" height="12" viewBox="0 0 10 14" fill="none" aria-hidden="true"><path d="M8 1 2 7l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                              <svg width="8" height="12" viewBox="0 0 10 14" fill="none" aria-hidden="true"><path d="m2 1 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </button>
                          </div>
                        </div>
                      </figure>
                    )}
                    {d.diagram && (
                      <figure class="light"><img src={d.diagram.src} alt={d.diagram.alt} width={d.diagram.width} height={d.diagram.height} loading="lazy" decoding="async" /></figure>
                    )}
                    {d.rows.map((r) => (
                      <figure class:list={{ 'wide-pair': r.before.images.every(isWide) }}>
                        {[['Before', r.before], ['After', r.after]].map(([label, side]) => (
                          <div class:list={['board', label === 'Before' ? 'is-before' : 'is-after']}>
                            <div><h4>{label}</h4><h3>{side.title}</h3></div>
                            <div class="board-shots">
                              {side.images.map((img) => (
                                <img class:list={{ wide: isWide(img) }} src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" />
                              ))}
                            </div>
                          </div>
                        ))}
                      </figure>
                    ))}
                    {d.features.length > 0 && (
                      <figure>
                        {d.features.map((f) => (
                          <div class="board">
                            <div><h4>Added</h4><h3>{f.title}</h3></div>
                            <div class="board-shots"><img src={f.src} alt={f.alt} width={f.width} height={f.height} loading="lazy" decoding="async" /></div>
                          </div>
                        ))}
                      </figure>
                    )}
                    {d.prototype?.frame && !d.gallery.some((g) => g.frame === d.prototype!.frame) && (
                      <figure class="pmx" aria-label={d.prototype.label} set:html={frameHtml[`../content/playmate-frames/${d.prototype.frame}.html`]}></figure>
                    )}
                    {d.prototype && !d.prototype.frame && (
                      <figure class="prototype">
                        <div class="device">
                          {d.prototype.src ? (
                            <iframe src={d.prototype.src} title={`${d.title} prototype`} loading="lazy" allowfullscreen></iframe>
                          ) : d.prototype.poster && (
                            <img src={d.prototype.poster.src} alt={d.prototype.poster.alt} width={d.prototype.poster.width} height={d.prototype.poster.height} loading="lazy" decoding="async" />
                          )}
                        </div>
                        <div class="prototype-copy">
                          <h4>{d.prototype.label}</h4>
                          <h2>{d.prototype.title}</h2>
                          <p>{d.prototype.text}</p>
                          {d.prototype.href ? (
                            <a class="link primary" href={d.prototype.href} target="_blank" rel="noopener noreferrer"><h3>{d.prototype.cta}</h3><Fragment set:html={arrow} /></a>
                          ) : (
                            <span class="link is-soon" aria-disabled="true"><h3>{d.prototype.cta}</h3></span>
                          )}
                        </div>
                      </figure>
                    )}
                    {d.gallery.filter((g) => g.frame?.endsWith('summary')).map((g) => (
                      <figure class="pmx" aria-label="Summary" set:html={frameHtml[`../content/playmate-frames/${g.frame}.html`]}></figure>
                    ))}
                    {!d.gallery.some((g) => g.frame?.endsWith('summary')) && <div class:list={['info', { 'no-scope': !p.body?.trim(), 'has-overview': d.gallery.some((g) => g.info) }]}>
                      {d.gallery.filter((g) => g.info && g.beats).map((g) => (
                        <div class="info-overview" aria-label={g.label}>
                          {[0, 1].map((side) => (
                            <div class="info-overview-col">
                              {g.beats!.filter((_, n) => n % 2 === side).map((b) => <section><h4>{b.name}</h4>{b.text && <p>{b.text}</p>}</section>)}
                            </div>
                          ))}
                        </div>
                      ))}
                      {p.body?.trim() && (
                        <div class="info-scope">
                          <h3>Scope</h3>
                          <Content />
                        </div>
                      )}
                      {role && <div class="pill"><h3>Position</h3><h3>{role.replace(/\s*\(.*\)/, '')}</h3></div>}
                      <div class="pill"><h3>Time</h3><h3>{d.year}</h3></div>
                      {tools && <div class="pill"><h3>Tools</h3><h3>{tools}</h3></div>}
                      {platform && <div class="pill"><h3>Platform</h3><h3>{platform.split(' · ')[0]}</h3></div>}
                      {(d.link || d.seeMore || d.page || d.details.length > 0) && (
                        <div class="links">
                          {d.link && <a class="link" href={d.link.href} target="_blank" rel="noopener noreferrer"><h3>App Store</h3><Fragment set:html={arrow} /></a>}
                          {d.link && !d.page && d.details.length === 0 ? null : d.page ? (
                            <a class="link" href={d.page}><h3>See more</h3><Fragment set:html={arrow} /></a>
                          ) : d.details.length > 0 ? (
                            <button class="link" type="button" aria-expanded="false" aria-controls={`${p.id}-details`} data-details-open><h3>See more</h3><Fragment set:html={arrow} /></button>
                          ) : d.link || !d.seeMore ? null : (
                            <a class="link" href={`mailto:n.yagmur.simsek@gmail.com?subject=${encodeURIComponent(`${d.title} — see more`)}`}><h3>See more</h3><Fragment set:html={arrow} /></a>
                          )}
                        </div>
                      )}
                    </div>}
                  </div>
                </article>
                {d.details.length > 0 && (
                  <aside class="details" id={`${p.id}-details`} aria-label={`${d.title} details`} aria-hidden="true" data-details>
                    <div class="details-head">
                      <h3>{d.title}</h3>
                      <button class="details-close" type="button" aria-label="Close details" data-details-close>
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9 3h2v6h6v2h-6v6H9v-6H3V9h6z" /></svg>
                      </button>
                    </div>
                    <div class="details-body">
                      {d.details.map((sec) => (
                        <section class="details-section">
                          <h4>{sec.label}</h4>
                          {sec.title && <h3>{sec.title}</h3>}
                          {sec.text && <p>{sec.text}</p>}
                          {sec.images.length > 0 && (
                            <div class="details-images">{sec.images.map((im) => <img src={im.src} alt={im.alt} width={im.width} height={im.height} loading="lazy" decoding="async" />)}</div>
                          )}
                          {sec.points.length > 0 && <ul class="details-points">{sec.points.map((pt) => <li>{pt}</li>)}</ul>}
                          {sec.stats.length > 0 && (
                            <ul class="details-stats">
                              {sec.stats.map((st) => (
                                <li><strong>{st.value}</strong><span>{st.issue}</span>{st.fix && <em>→ {st.fix}</em>}</li>
                              ))}
                            </ul>
                          )}
                        </section>
                      ))}
                    </div>
                  </aside>
                )}
              </div>
            </section>
          );
        })}
      </div>
    </main>
  </div>
</Base>
