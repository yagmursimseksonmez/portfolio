---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Yagmur Şimşek Sönmez" description="This page does not exist." noindex>
  <main class="min-h-screen grid place-items-center bg-background text-foreground px-6">
    <div class="text-center">
      <div class="font-mono text-[22px] tracking-widest text-signal mb-3">◆ 404</div>
      <h1 class="font-display text-4xl md:text-5xl tracking-tighter mb-4">Page not found</h1>
      <p class="text-muted-foreground mb-8">The page you are looking for does not exist or has moved.</p>
      <a href="/" class="inline-flex rounded-full bg-signal text-background px-6 py-3 font-mono text-[12px] tracking-widest uppercase hover:opacity-90 transition-opacity">Back to homepage</a>
    </div>
  </main>
</Base>
