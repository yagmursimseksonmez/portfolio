---
import Base from '../../layouts/Base.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import site from '../../data/site.json';
import gate from '../../content/crypto-gate.html?raw';
import { person } from '../../data/person';

const fragments = import.meta.glob('../../content/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

export function getStaticPaths() {
  return Object.keys(site.pages)
    .filter((slug) => slug !== 'home')
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: string };
const page = site.pages[slug as keyof typeof site.pages];
const isProtected = slug === 'crypto-auth';
const content = isProtected ? gate : fragments[`../../content/${slug}.html`];
---
<Base
  title={page.title}
  description={page.description}
  image={page.image}
  noindex={'noindex' in page && page.noindex}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yagmursimseksonmez.com/' },
        { '@type': 'ListItem', position: 2, name: site.projects[slug]?.title ?? slug, item: `https://yagmursimseksonmez.com/projects/${slug}/` },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: site.projects[slug]?.title ?? slug,
      description: page.description,
      image: new URL(page.image, Astro.site).href,
      url: `https://yagmursimseksonmez.com/projects/${slug}/`,
      inLanguage: 'en',
      author: { '@id': person['@id'] },
    },
  ]}
>
  <div class="min-h-screen bg-background text-foreground" data-protected={isProtected ? 'crypto' : undefined}>
    <ProjectHeader current={slug} />
    <Fragment set:html={content} />
  </div>
</Base>
