---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Footer from '../../components/Footer.astro';
import { person } from '../../data/person';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, index: i, next: projects[(i + 1) % projects.length] },
  }));
}

const { entry, index, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const url = `https://yagmursimseksonmez.com/projects/${entry.id}/`;
const num = String(index + 1).padStart(2, '0');
---
<Base
  title={`${d.title} — Yagmur Şimşek Sönmez`}
  description={d.description}
  image={d.ogImage}
  noindex={d.noindex}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yagmursimseksonmez.com/' },
        { '@type': 'ListItem', position: 2, name: d.title, item: url },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: d.title,
      description: d.description,
      image: new URL(d.ogImage, Astro.site).href,
      url,
      inLanguage: 'en',
      author: { '@id': person['@id'] },
    },
  ]}
>
  <TopBar current="work" />

  <main class="wrap">
    <header class="case-head">
      <div class="case-head__eyebrow mono">
        <a href="/#work">← Work</a><span>Case / {num}</span><span>{d.year}</span>
      </div>
      <h1 class="case-title">{d.title}</h1>
      <p class="case-summary">{d.summary}</p>

      {d.facts.length > 0 && (
        <dl class="facts">
          {d.facts.map((f) => (
            <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
          ))}
        </dl>
      )}
      {d.link && (
        <div class="case-actions">
          <a class="btn" href={d.link.href} target="_blank" rel="noopener noreferrer">{d.link.label} ↗</a>
        </div>
      )}
    </header>

    {d.status === 'complete' ? (
      <>
        <section class="block snapshot">
          <span class="label">Project snapshot</span>
          <div>
            <div class="prose"><Content /></div>
            {d.kicker && <p class="kicker">{d.kicker}</p>}
          </div>
        </section>

        {d.compare && (
          <section class="block">
            <span class="label">Before / after — drag to compare</span>
            <div class="frame compare" data-compare>
              <img src={d.compare.before.src} alt={d.compare.before.alt} width={d.compare.before.width} height={d.compare.before.height} draggable="false" decoding="async" />
              <img class="compare__after" src={d.compare.after.src} alt={d.compare.after.alt} width={d.compare.after.width} height={d.compare.after.height} draggable="false" decoding="async" />
              <div class="compare__handle">
                <button class="compare__knob" type="button" role="slider" aria-label="Compare before and after" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
                  <svg width="8" height="12" viewBox="0 0 10 14" fill="none" aria-hidden="true"><path d="M8 1 2 7l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <svg width="8" height="12" viewBox="0 0 10 14" fill="none" aria-hidden="true"><path d="m2 1 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
              </div>
            </div>
          </section>
        )}

        {d.diagram && (
          <figure class="block">
            <figcaption class="label">{d.diagram.label}</figcaption>
            <div class="frame frame--light">
              <img src={d.diagram.src} alt={d.diagram.alt} width={d.diagram.width} height={d.diagram.height} loading="lazy" decoding="async" />
            </div>
          </figure>
        )}

        {d.rows.length > 0 && (
          <section class="block">
            <div class="ba-head"><span class="label">Before</span><span class="label">After</span></div>
            {d.rows.map((r) => {
              const wide = r.before.images.some((img) => img.width && img.height && img.width > img.height);
              return (
                <div class:list={['ba', { 'ba--wide': wide }]}>
                  <div class="ba__before">
                    <span class="label ba__mobile-label">Before</span>
                    <h3>{r.before.title}</h3>
                    <div class="ba__shots">
                      {r.before.images.map((img) => <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" />)}
                    </div>
                  </div>
                  <div class="ba__after" style={`--n:${wide ? 1 : 2}`}>
                    <span class="label ba__mobile-label">After</span>
                    <h3>{r.after.title}</h3>
                    <div class="ba__shots">
                      {r.after.images.map((img) => <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" />)}
                    </div>
                  </div>
                </div>
              );
            })}
          </section>
        )}

        {d.features.length > 0 && (
          <section class="block">
            <span class="label">Added features</span>
            <div class="features">
              {d.features.map((f) => (
                <figure>
                  <figcaption>{f.title}</figcaption>
                  <img src={f.src} alt={f.alt} width={f.width} height={f.height} loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="block">
        {d.cover && (
          <div class="frame">
            <img src={d.cover.src} alt={d.cover.alt} width={d.cover.width} height={d.cover.height} decoding="async" />
          </div>
        )}
        <div class="notice">
          <span class="label">{d.status === 'rewriting' ? 'Being rewritten' : 'In progress'}</span>
          <p>
            {d.status === 'rewriting'
              ? 'This case study is getting a shorter, sharper rewrite. Happy to walk you through it in the meantime.'
              : 'The full case study is on its way. Happy to walk you through the work in the meantime.'}
          </p>
          <div><a class="btn btn--sm" href="mailto:n.yagmur.simsek@gmail.com">Ask for a walkthrough →</a></div>
        </div>
      </section>
    )}

    <a class="next" href={`/projects/${next.id}/`}>
      <div>
        <span class="mono fog">Next case</span>
        <p class="next__title">{next.data.title}</p>
      </div>
      <span class="next__arrow" aria-hidden="true">→</span>
    </a>
  </main>

  <Footer />
</Base>
